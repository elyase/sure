# Small overlay on the upstream ARM64-tested release; no dependencies or assets change.
ARG BASE_IMAGE=ghcr.io/we-promise/sure@sha256:391b2c52acfe538065a41cdd1c9755f90d95ba17a2c06e9b6438b12098df3f3a
FROM ${BASE_IMAGE}
COPY --chown=1000:1000 app/models/enable_banking_entry/processor.rb /rails/app/models/enable_banking_entry/processor.rb
COPY --chown=1000:1000 app/models/enable_banking_item/importer.rb /rails/app/models/enable_banking_item/importer.rb
COPY --chown=1000:1000 app/models/enable_banking_item/n26_transaction_identity.rb /rails/app/models/enable_banking_item/n26_transaction_identity.rb
ARG PATCH_COMMIT_SHA
ENV BUILD_COMMIT_SHA=${PATCH_COMMIT_SHA}
